generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Cambiarlo invalida todas las sesiones existentes
  tokenVersion Int      @default(0)
  theme        String   @default("paper")
  haptics      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events        Event[]
  tasks         Task[]
  focusSessions FocusSession[]
  memberships   TeamMember[]
  sentInvites   TeamInvite[]
}

/// Equipo de trabajo con calendario compartido.
model Team {
  id        String   @id @default(uuid())
  name      String
  /// Clave de color del equipo: rojo, verde, azul, ocre, violeta, grafito
  color     String   @default("azul")
  /// Código para unirse con un enlace; se puede regenerar
  joinCode  String   @unique
  createdAt DateTime @default(now())

  members TeamMember[]
  invites TeamInvite[]
  events  Event[]
}

model TeamMember {
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner | member
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

/// Invitación por email: sirve para personas con cuenta y sin ella.
model TeamInvite {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([teamId, email])
  @@index([email])
}

model Event {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  /// YYYY-MM-DD, sin zona horaria para no desplazar el día
  date     String
  /// Minutos desde medianoche
  start    Int
  duration Int
  category String @default("trabajo")
  location String @default("")
  note     String @default("")
  attendees String[] @default([])
  /// Si es de un equipo, lo ven y editan todos sus miembros
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  checklist ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, updatedAt])
  @@index([teamId, date])
}

model ChecklistItem {
  id       String  @id @default(uuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([eventId])
}

model Task {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// YYYY-MM-DD o null
  due       String?
  tag       String   @default("personal")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, done])
  @@index([userId, due])
}

model FocusSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes     Int
  completedAt DateTime @default(now())

  @@index([userId, completedAt])
}

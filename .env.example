# Copia este archivo a .env y rellena los valores.

# --- Desarrollo local con Vite (npm run dev) ---
DATABASE_URL="postgresql://pulso:cambia-esta-password@localhost:5432/pulso?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-de-64-caracteres-aleatorios"
PORT=3001
APP_ORIGIN="http://localhost:5180"
COOKIE_SECURE="false"
SEED_DEMO="true"
TZ="Europe/Madrid"

# --- Docker Compose / Coolify ---
# El contenedor construye DATABASE_URL a partir de estas tres.
POSTGRES_USER="pulso"
POSTGRES_PASSWORD="cambia-esta-password"
POSTGRES_DB="pulso"
APP_PORT=3000
# En producción: https://tu-dominio.com y true
APP_ORIGIN_PUBLIC="http://localhost:3000"
COOKIE_SECURE_PUBLIC="false"
